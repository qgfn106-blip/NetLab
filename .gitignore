# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# 运行期临时文件
*.tmp.json
*.log

# 对外发布时排除的内容（测试与文档要进版本库：它们是可复现性的一部分）
MyProject/
netlab/tools/

# 共享库与扩展：只保留目录骨架，个人数据不入库
library/*
!library/.gitkeep
extensions/*
!extensions/.gitkeep
# 插件包是代码，不是个人数据：只保留官方随仓库分发的插件
!extensions/plugins/
!extensions/plugins/README.md
!extensions/plugins/netlab.plotkit/
!extensions/plugins/netlab.plotkit/**
extensions/plugins/netlab.plotkit/__pycache__/

# 操作系统杂项
.DS_Store
Thumbs.db
desktop.ini

# 本地产物（2026-11-04）：备份/截图目录与运行期布局文件不入库
NetlabExtras/
layout.json
vscode-extensions/netlab-sidebar/node_modules/
node_modules/

# PyInstaller 打包产物（POC，2026-11-06）：构建目录与 dist 不入库；spec 入库以便复现
build/
dist/

# 工程迁移备份文件不入库（W4，2026-11-08）：.netlab 压缩迁移前的原始纯文本备份
*.netlab.bak-*
*.netlab.bak
