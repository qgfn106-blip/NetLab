{
  "name": "netlab-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild app.ts app.utils.ts --format=esm --target=es2020 --outdir=. --log-level=warning && esbuild desktop-shim.ts --format=iife --target=es2020 --outfile=desktop-shim.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:utils": "node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "5.6.3"
  }
}
