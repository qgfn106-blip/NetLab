# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.pytest_tmp/
.coverage
coverage.json
htmlcov/

# 运行期临时文件
*.tmp.json
*.log

# 对外发布时排除的内容（测试与文档要进版本库：它们是可复现性的一部分）
MyProject/
netlab/tools/

# 共享库与扩展：只保留目录骨架，个人数据不入库
library/*
!library/.gitkeep
extensions/*
!extensions/.gitkeep
# 插件包是代码，不是个人数据：只保留官方随仓库分发的插件
!extensions/plugins/
!extensions/plugins/README.md
!extensions/plugins/netlab.plotkit/
!extensions/plugins/netlab.plotkit/**
extensions/plugins/netlab.plotkit/__pycache__/

# 操作系统杂项
.DS_Store
Thumbs.db
desktop.ini

# 本地产物（2026-11-04）：备份/截图目录与运行期布局文件不入库
NetlabExtras/
layout.json
vscode-extensions/netlab-sidebar/node_modules/
node_modules/

# PyInstaller 打包产物（POC，2026-11-06）：构建目录与 dist 不入库；spec 入库以便复现
build/
dist/

# Python 构建产物（C-4，2026-11-08）：wheel 二进制不入库（X6）
*.whl

# 工程迁移备份文件不入库（W4，2026-11-08）：.netlab 压缩迁移前的原始纯文本备份
*.netlab.bak-*
*.netlab.bak

# G1 架构/契约生成报告
reports/*
!reports/e2e/
!reports/e2e/**
!reports/e2e-mutation/
!reports/e2e-mutation/**
!reports/shadow/
!reports/shadow/**
!reports/bench_scale.json
!reports/bench_ac_backends_*.json
!reports/test_status.json
!reports/pytest.xml
CON

# ==== GitHub 隐私安全门禁（2026-11-13，见 netlab/docs/GITHUB_CONTRIBUTION_PRIVACY_SECURITY_POLICY.md）====
# 本机凭证/密钥：绝对禁止上传
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
.git-credentials
# 本地 Agent 配置（若出现在仓库内）
.dsh/
.codex/
# 其它 Python 缓存
.mypy_cache/
.ruff_cache/
.cache/
# 本地运行期数据与覆盖率分片
*.tmp
*.sqlite
*.sqlite3
.coverage.*
